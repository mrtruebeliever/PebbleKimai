{
  "name": "pebblekimai",
  "author": "mrtruebeliever",
  "version": "2.8.1",
  "license": "MIT",
  "keywords": ["pebble-app"],
  "private": true,
  "dependencies": {
    "pebble-clay": "^1.0.4"
  },
  "pebble": {
    "displayName": "PebbleKimai",
    "uuid": "dffe682e-6765-4d7b-ae79-127750c542a2",
    "sdkVersion": "3",
    "enableMultiJS": true,
    "capabilities": [
      "configurable"
    ],
    "targetPlatforms": [
      "aplite",
      "basalt",
      "chalk",
      "diorite",
      "emery"
    ],
    "watchapp": {
      "watchface": false
    },
    "messageKeys": [
      "KIMAI_URL",
      "KIMAI_TOKEN",
      "DEFAULT_PROJECT",
      "DEFAULT_CUSTOMER",
      "LANGUAGE",
      "LOAD_STATE",
      "ACT_COUNT",
      "ACT_INDEX",
      "ACT_ID",
      "ACT_NAME",
      "PROJ_COUNT",
      "PROJ_INDEX",
      "PROJ_ID",
      "PROJ_NAME",
      "PROJ_CUSTOMER_ID",
      "PROJ_CUSTOMER_NAME",
      "TIMER_STATUS",
      "TIMER_TS_ID",
      "TIMER_ACT_ID",
      "TIMER_ACT_NAME",
      "TIMER_BEGIN",
      "ERROR_CODE",
      "REQUEST_ACTIVITIES",
      "REQUEST_PROJECTS",
      "REQUEST_TIMER",
      "PROJECT_ID",
      "START_ACTIVITY",
      "STOP_ACTIVITY",
      "SWITCH_ACTIVITY",
      "ACT_PROJECT_ID",
      "TIMER_PROJECT_ID",
      "REQUEST_RECENTS",
      "RECENT_COUNT",
      "RECENT_INDEX",
      "RECENT_ID",
      "RECENT_NAME",
      "RECENT_PROJECT_ID",
      "RECENT_PROJECT_NAME"
    ],
    "resources": {
      "media": [
        {
          "type": "png",
          "name": "IMG_MENU_ICON",
          "file": "images/menu_icon.png",
          "menuIcon": true
        },
        {
          "type": "png",
          "name": "IMG_HEADER_ICON",
          "file": "images/header_icon.png"
        },
        {
          "type": "png",
          "name": "IMG_STATUS_RUNNING",
          "file": "images/status_running.png"
        },
        {
          "type": "png",
          "name": "IMG_STATUS_LAST",
          "file": "images/status_last.png"
        },
        {
          "type": "font",
          "name": "FONT_RAJDHANI_24",
          "file": "fonts/Rajdhani-Bold.ttf",
          "characterRegex": "[ -~À-ÿ]",
          "compatibility": "2.7"
        },
        {
          "type": "font",
          "name": "FONT_RAJDHANI_34",
          "file": "fonts/Rajdhani-Bold.ttf",
          "characterRegex": "[0-9: ]",
          "compatibility": "2.7"
        },
        {
          "type": "font",
          "name": "FONT_RAJDHANI_46",
          "file": "fonts/Rajdhani-Bold.ttf",
          "characterRegex": "[0-9: ]",
          "compatibility": "2.7"
        }
      ]
    }
  }
}
